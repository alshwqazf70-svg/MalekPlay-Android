<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Back up lightweight preferences only. The Room database and media
         cache are re-derived from MediaStore and must not be archived. -->
    <include domain="sharedpref" path="malekplay_family.xml" />
    <exclude domain="database" path="malekplay.db" />
    <exclude domain="database" path="malekplay.db-wal" />
    <exclude domain="database" path="malekplay.db-shm" />
    <exclude domain="file" path="datastore" />
</full-backup-content>